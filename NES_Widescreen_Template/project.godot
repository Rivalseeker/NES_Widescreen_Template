; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NES Widescreen Template"
config/tags=PackedStringArray("ai", "beatemup", "starterkit")
run/main_scene="res://Scenes/MainSample.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

DisplayManager="*res://Scripts/Core/DisplayManager.cs"
NesSpriteManager="*res://Scripts/Core/NesSpriteManager.cs"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/resizable=false
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="NES_Widescreen_Template"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.08, 1)
